rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened global primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAllowedUser() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'myhagenja@gmail.com',
          'inna.didenko46@gmail.com',
          'inna.m.mukha@gmail.com'
        ];
    }

    function isOwner(userId) {
      return isAllowedUser() && request.auth.uid == userId;
    }

    function isAirsoftWorkspace(workspaceId) {
      return workspaceId == 'airsoft-serwis';
    }

    // 3. Entity validation blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSharedWorkspace(data, workspaceId) {
      return data.keys().hasAll(['id', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == workspaceId
        && data.id.size() >= 1
        && data.id.size() <= 64
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAirsoftConfig(data) {
      return data.keys().hasAll(['ownerId', 'partsCatalog', 'serviceRates', 'suppliers', 'settings', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'partsCatalog', 'serviceRates', 'suppliers', 'settings', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.partsCatalog is list
        && data.partsCatalog.size() <= 200
        && (data.partsCatalog.size() == 0 || data.partsCatalog[0] is map)
        && data.serviceRates is list
        && data.serviceRates.size() <= 100
        && (data.serviceRates.size() == 0 || data.serviceRates[0] is map)
        && data.suppliers is list
        && data.suppliers.size() <= 30
        && (data.suppliers.size() == 0 || data.suppliers[0] is string)
        && data.settings is map
        && data.settings.keys().size() <= 30
        && data.updatedAt is timestamp;
    }

    function isValidAirsoftDraft(data) {
      return data.keys().hasAll(['ownerId', 'currentTicket', 'quoteItems', 'quoteAttachments', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'currentTicket', 'quoteItems', 'quoteAttachments', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.currentTicket is map
        && data.currentTicket.keys().size() <= 60
        && data.quoteItems is list
        && data.quoteItems.size() <= 100
        && (data.quoteItems.size() == 0 || data.quoteItems[0] is map)
        && data.quoteAttachments is list
        && data.quoteAttachments.size() <= 6
        && (data.quoteAttachments.size() == 0 || data.quoteAttachments[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidRepairOrderRecord(data, workspaceId, repairId) {
      return data.keys().hasAll(['id', 'workspaceId', 'ownerId', 'stage', 'paymentStatus', 'ticket', 'result', 'replicaLabel', 'partsSummary', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'workspaceId', 'ownerId', 'stage', 'paymentStatus', 'documentRef', 'recordedAtIso', 'ticket', 'result', 'replicaLabel', 'partsSummary', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == repairId
        && data.id.size() >= 1
        && data.id.size() <= 128
        && data.workspaceId is string
        && data.workspaceId == workspaceId
        && data.workspaceId.size() >= 1
        && data.workspaceId.size() <= 64
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.stage in ['przyjecie', 'diagnostyka', 'oczekuje_akceptacji', 'zakup_czesci', 'w_realizacji', 'testy_chrono', 'gotowe']
        && data.paymentStatus in ['oczekuje', 'zaliczka', 'oplacone', 'wyslane']
        && (!('documentRef' in data) || (data.documentRef is string && data.documentRef.size() <= 160))
        && (!('recordedAtIso' in data) || (data.recordedAtIso is string && data.recordedAtIso.size() <= 40))
        && data.ticket is map
        && data.ticket.keys().size() <= 60
        && data.result is map
        && data.result.keys().size() <= 40
        && data.replicaLabel is string
        && data.replicaLabel.size() <= 160
        && data.partsSummary is string
        && data.partsSummary.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection rules

    // 4a. Dedicated Airsoft Serwis workspace (strictly allowlisted verified users only)
    match /workspaces/{workspaceId} {
      allow get: if isAllowedUser() && isValidId(workspaceId) && isAirsoftWorkspace(workspaceId);
      allow list: if false;
      allow create: if isAllowedUser()
        && isValidId(workspaceId)
        && isAirsoftWorkspace(workspaceId)
        && isValidSharedWorkspace(incoming(), workspaceId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAllowedUser()
        && isValidId(workspaceId)
        && isAirsoftWorkspace(workspaceId)
        && isValidSharedWorkspace(incoming(), workspaceId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']);
      allow delete: if false;

      match /settings/config {
        allow get: if isAllowedUser()
          && isValidId(workspaceId)
          && isAirsoftWorkspace(workspaceId)
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
        allow list: if false;
        allow create: if isAllowedUser()
          && isValidId(workspaceId)
          && isAirsoftWorkspace(workspaceId)
          && isValidAirsoftConfig(incoming())
          && incoming().ownerId == request.auth.uid
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
        allow update: if isAllowedUser()
          && isValidId(workspaceId)
          && isAirsoftWorkspace(workspaceId)
          && isValidAirsoftConfig(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['partsCatalog', 'serviceRates', 'suppliers', 'settings', 'updatedAt'])
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
        allow delete: if false;
      }

      match /settings/draft {
        allow get: if isAllowedUser()
          && isValidId(workspaceId)
          && isAirsoftWorkspace(workspaceId)
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
        allow list: if false;
        allow create: if isAllowedUser()
          && isValidId(workspaceId)
          && isAirsoftWorkspace(workspaceId)
          && isValidAirsoftDraft(incoming())
          && incoming().ownerId == request.auth.uid
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
        allow update: if isAllowedUser()
          && isValidId(workspaceId)
          && isAirsoftWorkspace(workspaceId)
          && isValidAirsoftDraft(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['currentTicket', 'quoteItems', 'quoteAttachments', 'updatedAt'])
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
        allow delete: if false;
      }

      match /repairs/{repairId} {
        allow get: if isAllowedUser()
          && isValidId(workspaceId)
          && isAirsoftWorkspace(workspaceId)
          && isValidId(repairId)
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
        allow list: if isAllowedUser()
          && isAirsoftWorkspace(workspaceId)
          && resource.data.workspaceId == 'airsoft-serwis';
        allow create: if isAllowedUser()
          && isValidId(workspaceId)
          && isAirsoftWorkspace(workspaceId)
          && isValidId(repairId)
          && isValidRepairOrderRecord(incoming(), workspaceId, repairId)
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
        allow update: if isAllowedUser()
          && isValidId(workspaceId)
          && isAirsoftWorkspace(workspaceId)
          && isValidId(repairId)
          && isValidRepairOrderRecord(incoming(), workspaceId, repairId)
          && incoming().id == existing().id
          && incoming().workspaceId == existing().workspaceId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['documentRef', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['ticket', 'result', 'partsSummary', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'paymentStatus', 'documentRef', 'ticket', 'result', 'replicaLabel', 'partsSummary', 'updatedAt'])
          )
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
        allow delete: if isAllowedUser()
          && isValidId(workspaceId)
          && isAirsoftWorkspace(workspaceId)
          && isValidId(repairId)
          && exists(/databases/$(database)/documents/workspaces/$(workspaceId));
      }
    }

    // 4b. Operator user profiles (allowlisted owner only)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow delete: if false;
    }
  }
}
